+  // Lumina: a self-hosted, Telegram-compatible server ("host:port") serves
+  // every DC; it hands out its own dc_options through help.getConfig.
+  if (const char *custom = std::getenv("LUMINA_SERVER")) {
+    Slice server(custom);
+    auto colon = server.rfind(':');
+    if (!server.empty() && colon != static_cast<size_t>(-1)) {
+      auto host = server.substr(0, colon).str();
+      if (host.size() > 2 && host[0] == '[' && host.back() == ']') {
+        host = host.substr(1, host.size() - 2);
+      }
+      auto port = to_integer<int>(server.substr(colon + 1));
+      for (int32 dc_id = 1; dc_id <= 5; dc_id++) {
+        IPAddress ip_address;
+        if (ip_address.init_host_port(host, port).is_ok()) {
+          res.dc_options.emplace_back(DcId::internal(dc_id), ip_address);
+        }
+      }
+      return res;
+    }
+  }
